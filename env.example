# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Куда присылать заявки (узнать: напиши боту /id)
OWNER_CHAT_ID=123456789

# Какой ИИ использовать: gemini (бесплатно) или claude (платно, для клиентов)
PROVIDER=gemini

# Бесплатный ключ: aistudio.google.com -> Get API key
GEMINI_API_KEY=AIza...

# Нужен только если PROVIDER=claude: platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Модель можно не указывать — подставится дешёвая по умолчанию
MODEL=
